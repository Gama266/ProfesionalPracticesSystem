<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="600.0" prefWidth="850.0" spacing="20.0" style="-fx-background-color: #f1f5f9; -fx-padding: 30;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.controller.ConsultTechnicalResponsibleGUIController">
    
    <VBox style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10;">
        <Label text="Directorio de Responsables Técnicos">
            <font>
                <Font name="System Bold" size="20.0" />
            </font>
        </Label>
        <Label text="Directorio de los responsables técnicos registrados en el sistema." textFill="#64748b" />
    </VBox>
    
    <TableView fx:id="tableViewTechnicalResponsibles" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="columnName" prefWidth="130.0" text="Nombre" />
            <TableColumn fx:id="columnPaternalSurname" prefWidth="130.0" text="Apellido Paterno" />
            <TableColumn fx:id="columnLinkedOrganization" prefWidth="180.0" text="Organización" />
            <TableColumn fx:id="columnEmail" prefWidth="200.0" text="Correo Electrónico" />
            <TableColumn fx:id="columnPhoneNumber" prefWidth="110.0" text="Teléfono" />
            <TableColumn fx:id="columnActions" prefWidth="100.0" text="Acciones" />
        </columns>
    </TableView>
    
</VBox>