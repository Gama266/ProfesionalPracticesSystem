<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="gui.controller.ConsultStudentController">

    <top>

        <VBox spacing="15">

            <padding>
                <Insets top="20"
                        right="20"
                        bottom="15"
                        left="20"/>
            </padding>

            <Label text="Consulta de Estudiantes"
                   style="-fx-font-size: 24px;
                          -fx-font-weight: bold;" />

            <HBox spacing="10"
                  alignment="CENTER_LEFT">

                <Label text="Buscar estudiante:" />

                <TextField fx:id="searchTextField"
                           promptText="Buscar por matrícula o nombre"
                           prefWidth="320"/>

            </HBox>

        </VBox>

    </top>

    <center>

        <HBox spacing="20">

            <padding>
                <Insets top="0"
                        right="20"
                        bottom="20"
                        left="20"/>
            </padding>

            <VBox spacing="10"
                  HBox.hgrow="ALWAYS">

                <TableView fx:id="studentTableView"
                           VBox.vgrow="ALWAYS">

                    <columns>

                        <TableColumn fx:id="enrollmentColumn"
                                     text="Matrícula"
                                     prefWidth="140"/>

                        <TableColumn fx:id="fullNameColumn"
                                     text="Nombre Completo"
                                     prefWidth="320"/>

                        <TableColumn fx:id="statusColumn"
                                     text="Estado"
                                     prefWidth="120"/>

                    </columns>

                </TableView>

            </VBox>

            <VBox spacing="15"
                  prefWidth="320"
                  style="-fx-background-color: #f4f4f5;
                         -fx-padding: 20;
                         -fx-background-radius: 10;">

                <Label text="Detalle del Estudiante"
                       style="-fx-font-size: 18px;
                              -fx-font-weight: bold;" />

                <GridPane hgap="10"
                          vgap="12">

                    <Label text="Matrícula:"
                           GridPane.rowIndex="0"
                           GridPane.columnIndex="0"
                           style="-fx-font-weight: bold;" />

                    <Label fx:id="enrollmentDetailLabel"
                           text="—"
                           GridPane.rowIndex="0"
                           GridPane.columnIndex="1" />

                    <Label text="Nombre:"
                           GridPane.rowIndex="1"
                           GridPane.columnIndex="0"
                           style="-fx-font-weight: bold;" />

                    <Label fx:id="nameDetailLabel"
                           text="—"
                           GridPane.rowIndex="1"
                           GridPane.columnIndex="1" />

                    <Label text="Apellido paterno:"
                           GridPane.rowIndex="2"
                           GridPane.columnIndex="0"
                           style="-fx-font-weight: bold;" />

                    <Label fx:id="paternalSurnameDetailLabel"
                           text="—"
                           GridPane.rowIndex="2"
                           GridPane.columnIndex="1" />

                    <Label text="Apellido materno:"
                           GridPane.rowIndex="3"
                           GridPane.columnIndex="0"
                           style="-fx-font-weight: bold;" />

                    <Label fx:id="maternalSurnameDetailLabel"
                           text="—"
                           GridPane.rowIndex="3"
                           GridPane.columnIndex="1" />

                    <Label text="Estado:"
                           GridPane.rowIndex="4"
                           GridPane.columnIndex="0"
                           style="-fx-font-weight: bold;" />

                    <Label fx:id="statusDetailLabel"
                           text="—"
                           GridPane.rowIndex="4"
                           GridPane.columnIndex="1" />

                </GridPane>

            </VBox>

        </HBox>

    </center>

</BorderPane>