<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Accordion?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="700.0" prefWidth="1100.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.usersviews.CoordinatorMenuController">
   <left>
      <VBox prefHeight="700.0" prefWidth="260.0" style="-fx-background-color: #1e293b;" BorderPane.alignment="CENTER">
         <children>
            <Label text="Sistema Prácticas" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="22.0" />
               </font>
               <VBox.margin>
                  <Insets bottom="5.0" left="20.0" top="30.0" />
               </VBox.margin>
            </Label>
            <Label text="Módulo Coordinador" textFill="#94a3b8">
               <font>
                  <Font size="13.0" />
               </font>
               <VBox.margin>
                  <Insets bottom="30.0" left="20.0" />
               </VBox.margin>
            </Label>

            <Accordion VBox.vgrow="ALWAYS">
              <panes>
                
                <TitledPane animated="true" text="Organizaciones Vinculadas">
                   <content>
                      <VBox spacing="5.0" style="-fx-background-color: #334155;">
                         <children>
                            <Button mnemonicParsing="false" onAction="#RegisterLinkedOrganization" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-cursor: hand;" text="Registrar OV" />
                            <Button mnemonicParsing="false" onAction="#ConsultLinkedOrganization" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-cursor: hand;" text="Consultar OV" />
                            <Button mnemonicParsing="false" onAction="#RegisterTechnicalResponsible" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-cursor: hand;" text="Registrar Responsable" />
                            <Button mnemonicParsing="false" onAction="#ConsultTechnicalResponsible" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-cursor: hand;" text="Consultar Responsable" />
                         </children>
                      </VBox>
                   </content>
                     <font>
                        <Font name="System Bold" size="13.0" />
                     </font>
                </TitledPane>
                
                <TitledPane animated="true" text="Proyectos">
                   <content>
                      <VBox spacing="5.0" style="-fx-background-color: #334155;">
                         <children>
                            <Button mnemonicParsing="false" onAction="#RegisterProject" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-cursor: hand;" text="Registrar Proyecto" />
                             <Button mnemonicParsing="false" onAction="#openRegisterActivityView" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-cursor: hand;" text="Registrar Actividad" />
                            <Button mnemonicParsing="false" onAction="#AssignProject" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-cursor: hand;" text="Asignar Proyecto" />
                            <Button mnemonicParsing="false" onAction="#UpdateProject" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-cursor: hand;" text="Actualizar Proyecto" />
                            <Button mnemonicParsing="false" onAction="#DeleteProject" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-cursor: hand;" text="Eliminar Proyecto" />
                         </children>
                      </VBox>
                   </content>
                     <font>
                        <Font name="System Bold" size="13.0" />
                     </font>
                </TitledPane>

                <TitledPane animated="true" text="Exp. Educativas">
                   <content>
                      <VBox spacing="5.0" style="-fx-background-color: #334155;">
                         <children>
                            <Button mnemonicParsing="false" onAction="#RegisterEducationalExperience" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-cursor: hand;" text="Registrar EE" />
                            <Button mnemonicParsing="false" onAction="#ConsultEducationalExperience" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-cursor: hand;" text="Consultar EE" />
                         </children>
                      </VBox>
                   </content>
                     <font>
                        <Font name="System Bold" size="13.0" />
                     </font>
                </TitledPane>          
                
                <TitledPane animated="true" text="Estudiantes">
                   <content>
                      <VBox spacing="5.0" style="-fx-background-color: #334155;">
                         <children>
                            <Button mnemonicParsing="false" onAction="#RegisterStudent" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-cursor: hand;" text="Registrar Estudiante" />
                            <Button mnemonicParsing="false" onAction="#ConsultStudent" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-cursor: hand;" text="Consultar Estudiante" />
                            <Button mnemonicParsing="false" onAction="#DesactiveStudent" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-cursor: hand;" text="Inactivar Estudiante" />
                         </children>
                      </VBox>
                   </content>
                     <font>
                        <Font name="System Bold" size="13.0" />
                     </font>
                </TitledPane>

                <TitledPane animated="true" text="Profesores">
                   <content>
                      <VBox spacing="5.0" style="-fx-background-color: #334155;">
                         <children>
                            <Button mnemonicParsing="false" onAction="#btnConsultarProfesor" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-cursor: hand;" text="Consultar Profesor" />
                         </children>
                      </VBox>
                   </content>
                     <font>
                        <Font name="System Bold" size="13.0" />
                     </font>
                </TitledPane>

              </panes>
            </Accordion>

            <Button mnemonicParsing="false" onAction="#handleCerrarSesion" prefHeight="40.0" prefWidth="220.0" style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-background-radius: 6; -fx-font-weight: bold; -fx-cursor: hand;" text="Cerrar Sesión">
               <font><Font size="13.0" /></font>
               <VBox.margin><Insets bottom="30.0" left="20.0" top="15.0" /></VBox.margin>
            </Button>

         </children>
      </VBox>
   </left>

   <center>
      <StackPane fx:id="spContenido" style="-fx-background-color: #f1f5f9;" BorderPane.alignment="CENTER" />
   </center>
</BorderPane>