<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="600.0" prefWidth="800.0" spacing="20.0" style="-fx-background-color: #f1f5f9; -fx-padding: 30;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.controller.ConsultEducationalExperienceGUIController">
   <children>
      
      <VBox style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10;">
         <children>
            <Label text="Directorio de Experiencias Educativas">
               <font>
                  <Font name="System Bold" size="20.0" />
               </font>
            </Label>
            <Label text="Catálogo de las materias y experiencias educativas registradas en el sistema." textFill="#64748b" />
         </children>
      </VBox>

      <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 10;">
         <children>
            <Label text="Buscar por NRC:" textFill="#334155">
               <font>
                  <Font name="System Bold" size="13.0" />
               </font>
            </Label>
            <TextField fx:id="textFieldSearchNrc" prefWidth="140.0" promptText="Ej. 18432" style="-fx-background-radius: 6; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-background-color: #f8fafc;" />
            <Button mnemonicParsing="false" onAction="#handleSearch" style="-fx-background-color: #1e293b; -fx-text-fill: white; -fx-background-radius: 6; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 6 18;" text="Buscar" />
         </children>
      </HBox>

      <TableView fx:id="tableViewEducationalExperiences" VBox.vgrow="ALWAYS" style="-fx-background-radius: 10; -fx-overflow-x: hidden;">
        <columns>
          <TableColumn fx:id="tableColumnNrc" prefWidth="150.0" text="NRC" />
          <TableColumn fx:id="tableColumnEducationalExperienceName" prefWidth="590.0" text="Nombre de la Experiencia Educativa" />
        </columns>
      </TableView>

   </children>
</VBox>