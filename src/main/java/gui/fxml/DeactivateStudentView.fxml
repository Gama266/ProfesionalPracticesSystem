<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="gui.controller.DeactivateStudentController">

    <top>

        <VBox spacing="15">

            <padding>
                <Insets top="20"
                        right="20"
                        bottom="15"
                        left="20"/>
            </padding>
            
            <Label text="Inactivar estudiantes"
                   style="-fx-font-size: 24px;
                          -fx-font-weight: bold;" />

            <HBox spacing="10"
                  alignment="CENTER_LEFT">

                <Label text="Buscar estudiante:" />

                <TextField fx:id="searchTextField"
                           promptText="Buscar por matrícula o nombre"
                           prefWidth="320"/>

            </HBox>

        </VBox>

    </top>

    <center>

        <VBox spacing="10">

            <padding>
                <Insets top="0"
                        right="20"
                        bottom="20"
                        left="20"/>
            </padding>

            <TableView fx:id="studentTableView"
                       VBox.vgrow="ALWAYS">

                <columns>

                    <TableColumn fx:id="enrollmentColumn"
                                 text="Matrícula"
                                 prefWidth="140"/>

                    <TableColumn fx:id="fullNameColumn"
                                 text="Nombre completo"
                                 prefWidth="320"/>

                    <TableColumn fx:id="statusColumn"
                                 text="Estado"
                                 prefWidth="120"/>

                    <TableColumn fx:id="actionColumn"
                                 text="Acciones"
                                 prefWidth="140"/>

                </columns>

            </TableView>

        </VBox>

    </center>

</BorderPane>
