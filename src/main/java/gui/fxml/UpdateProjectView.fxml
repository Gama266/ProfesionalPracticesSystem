<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12.0"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="gui.controller.UpdateProjectController"
      prefWidth="700.0"
      prefHeight="800.0"
      style="-fx-background-color: #F7F9FC;">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Actualizar Proyecto"
           style="-fx-font-size: 24px;
                  -fx-font-weight: bold;
                  -fx-text-fill: #1F2937;"/>

    <Separator/>

    <VBox spacing="8">

        <Label text="Buscar proyecto por ID"
               style="-fx-font-size: 16px;
                      -fx-font-weight: bold;"/>

        <HBox spacing="10">

            <TextField fx:id="projectIdTextField"
                       promptText="Ingresa el ID del proyecto"
                       HBox.hgrow="ALWAYS"/>

            <Button text="Buscar"
                    onAction="#handleSearch"
                    style="-fx-background-color: #2563EB;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;"/>
        </HBox>

        <Label fx:id="searchErrorLabel"
               visible="false"
               managed="false"
               wrapText="true"
               style="-fx-text-fill: #DC2626;
                      -fx-font-size: 12px;"/>
    </VBox>

    <Separator/>

    <VBox spacing="14">

        <VBox spacing="4">
            <Label text="Nombre del Proyecto"/>
            <TextField fx:id="projectNameTextField"
                       promptText="Nombre del proyecto"/>

            <Label fx:id="nameErrorLabel"
                   visible="false"
                   managed="false"
                   style="-fx-text-fill: #DC2626;
                          -fx-font-size: 12px;"/>
        </VBox>

        <VBox spacing="4">
            <Label text="Descripción"/>
            <TextArea fx:id="projectDescriptionTextArea"
                      promptText="Descripción del proyecto"
                      prefRowCount="4"
                      wrapText="true"/>

            <Label fx:id="descriptionErrorLabel"
                   visible="false"
                   managed="false"
                   style="-fx-text-fill: #DC2626;
                          -fx-font-size: 12px;"/>
        </VBox>

        <VBox spacing="4">
            <Label text="Metodología"/>
            <TextField fx:id="methodologyTextField"
                       promptText="Metodología utilizada"/>

            <Label fx:id="methodologyErrorLabel"
                   visible="false"
                   managed="false"
                   style="-fx-text-fill: #DC2626;
                          -fx-font-size: 12px;"/>
        </VBox>

        <VBox spacing="4">
            <Label text="Objetivos"/>
            <TextArea fx:id="objectivesTextArea"
                      promptText="Objetivos del proyecto"
                      prefRowCount="4"
                      wrapText="true"/>

            <Label fx:id="objectivesErrorLabel"
                   visible="false"
                   managed="false"
                   style="-fx-text-fill: #DC2626;
                          -fx-font-size: 12px;"/>
        </VBox>
        
        <VBox spacing="4">
            <Label text="Fecha de Registro"/>
            <DatePicker fx:id="registrationDatePicker"/>

            <Label fx:id="dateErrorLabel"
                   visible="false"
                   managed="false"
                   style="-fx-text-fill: #DC2626;
                          -fx-font-size: 12px;"/>
        </VBox>

        <CheckBox fx:id="activeStatusCheckBox"
                  text="Proyecto activo"/>

    </VBox>

    <Separator/>

    <HBox spacing="12">

        <Button fx:id="updateProjectButton"
                text="Actualizar Proyecto"
                disable="true"
                onAction="#handleUpdate"
                style="-fx-background-color: #10B981;
                       -fx-text-fill: white;
                       -fx-font-weight: bold;
                       -fx-padding: 10 20 10 20;"/>

        <Button text="Limpiar"
                onAction="#handleClear"
                style="-fx-background-color: #6B7280;
                       -fx-text-fill: white;
                       -fx-font-weight: bold;
                       -fx-padding: 10 20 10 20;"/>
    </HBox>

    <Label fx:id="resultLabel"
           visible="false"
           managed="false"
           wrapText="true"/>

</VBox>