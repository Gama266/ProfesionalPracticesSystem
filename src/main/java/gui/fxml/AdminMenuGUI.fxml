<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane fx:id="bpPrincipal" prefHeight="700.0" prefWidth="1100.0" styleClass="mainFxmlClass" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.usersviews.AdminMenuController">
    <stylesheets>
        <URL value="@teachergui.css" />
    </stylesheets>

    <left>
        <VBox prefHeight="700.0" prefWidth="250.0" spacing="10.0" style="-fx-background-color: #1f2937;" BorderPane.alignment="CENTER">
            <children>
                <Label text="Sistema Prácticas" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="22.0" />
                    </font>
                    <VBox.margin>
                        <Insets bottom="5.0" left="20.0" top="30.0" />
                    </VBox.margin>
                </Label>
                <Label text="Módulo Administrador" textFill="#9ca3af">
                    <font>
                        <Font size="13.0" />
                    </font>
                    <VBox.margin>
                        <Insets bottom="30.0" left="20.0" />
                    </VBox.margin>
                </Label>

                <Button mnemonicParsing="false" onAction="#Registrationteacher" prefHeight="50.0" prefWidth="250.0" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: center-left; -fx-padding: 0 0 0 20; -fx-cursor: hand;" text="Registrar Profesor">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Button>
                
                <Button mnemonicParsing="false" onAction="#Managementteacher" prefHeight="50.0" prefWidth="250.0" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: center-left; -fx-padding: 0 0 0 20; -fx-cursor: hand;" text="Inactivar Profesor">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Button>

                <Region VBox.vgrow="ALWAYS" />

                <Button mnemonicParsing="false" onAction="#handleCloseSesion" prefHeight="40.0" prefWidth="210.0" style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-background-radius: 6; -fx-font-weight: bold; -fx-cursor: hand;" text="Cerrar Sesión">
                   <font><Font size="13.0" /></font>
                   <VBox.margin><Insets bottom="30.0" left="20.0" /></VBox.margin>
                </Button>
            </children>
        </VBox>
    </left>

    <center>
        <StackPane fx:id="stackpaneContenido" style="-fx-background-color: #f3f4f6;" BorderPane.alignment="CENTER" />
    </center>
</BorderPane>