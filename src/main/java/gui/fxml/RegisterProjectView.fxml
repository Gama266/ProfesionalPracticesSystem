<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="gui.controller.RegisterProjectController">

    <top>
        <VBox spacing="10">
            <padding>
                <Insets top="20" right="25" bottom="15" left="25"/>
            </padding>
            <Label text="Registro de Proyecto"
                   style="-fx-font-size: 26px; -fx-font-weight: bold;" />
            <Label text="Complete la información requerida para registrar un proyecto."
                   style="-fx-text-fill: #6b7280; -fx-font-size: 13px;" />
        </VBox>
    </top>

    <center>
        <StackPane fx:id="contentPane">
            <GridPane hgap="18" vgap="18">
                <padding>
                    <Insets top="10" right="25" bottom="20" left="25"/>
                </padding>
                <columnConstraints>
                    <ColumnConstraints percentWidth="25"/>
                    <ColumnConstraints percentWidth="75"/>
                </columnConstraints>

                <Label text="Nombre del proyecto:"
                       GridPane.rowIndex="0" GridPane.columnIndex="0"
                       style="-fx-font-weight: bold;" />
                <TextField fx:id="projectNameTextField"
                           promptText="Ingrese el nombre del proyecto"
                           GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Descripción:"
                       GridPane.rowIndex="1" GridPane.columnIndex="0"
                       style="-fx-font-weight: bold;" />
                <TextArea fx:id="projectDescriptionTextArea"
                          promptText="Ingrese la descripción del proyecto"
                          prefRowCount="4" wrapText="true"
                          GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Metodología:"
                       GridPane.rowIndex="2" GridPane.columnIndex="0"
                       style="-fx-font-weight: bold;" />
                <TextField fx:id="methodologyTextField"
                           promptText="Ingrese la metodología"
                           GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                <Label text="Objetivos:"
                       GridPane.rowIndex="3" GridPane.columnIndex="0"
                       style="-fx-font-weight: bold;" />
                <TextArea fx:id="objectivesTextArea"
                          promptText="Ingrese los objetivos del proyecto"
                          prefRowCount="4" wrapText="true"
                          GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                <Label text="Fecha de registro:"
                       GridPane.rowIndex="4" GridPane.columnIndex="0"
                       style="-fx-font-weight: bold;" />
                <DatePicker fx:id="registrationDatePicker"
                            GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                <Label text="Organización vinculada:"
                       GridPane.rowIndex="5" GridPane.columnIndex="0"
                       style="-fx-font-weight: bold;" />
                <ComboBox fx:id="linkedOrganizationComboBox"
                          promptText="Seleccione una organización"
                          maxWidth="Infinity"
                          GridPane.rowIndex="5" GridPane.columnIndex="1"/>

                <Label text="Responsable técnico:"
                       GridPane.rowIndex="6" GridPane.columnIndex="0"
                       style="-fx-font-weight: bold;" />
                <ComboBox fx:id="technicalResponsibleComboBox"
                          promptText="Seleccione un responsable técnico"
                          maxWidth="Infinity"
                          GridPane.rowIndex="6" GridPane.columnIndex="1"/>

                <Label text="Cupo de estudiantes:"
                       GridPane.rowIndex="7" GridPane.columnIndex="0"
                       style="-fx-font-weight: bold;" />
                <TextField fx:id="capacityTextField"
                           promptText="Ej. 5"
                           GridPane.rowIndex="7" GridPane.columnIndex="1"/>

                <Label text="Estado activo:"
                       GridPane.rowIndex="8" GridPane.columnIndex="0"
                       style="-fx-font-weight: bold;" />
                <CheckBox fx:id="activeStatusCheckBox"
                          text="Proyecto activo"
                          GridPane.rowIndex="8" GridPane.columnIndex="1"/>

                <Label text="Actividades:"
                       GridPane.rowIndex="9" GridPane.columnIndex="0"
                       style="-fx-font-weight: bold;" />
                <HBox spacing="12" alignment="CENTER_LEFT"
                      GridPane.rowIndex="9" GridPane.columnIndex="1">
                    <Label fx:id="activityCounterLabel"
                           text="Actividades registradas: 0 / --"
                           style="-fx-text-fill: #6b7280;"/>
                    <Button text="Agregar Actividad"
                            onAction="#handleAddActivity"/>
                </HBox>

            </GridPane>
        </StackPane>
    </center>

    <bottom>
        <HBox spacing="12" alignment="CENTER_RIGHT">
            <padding>
                <Insets top="10" right="25" bottom="20" left="25"/>
            </padding>
            <Button text="Limpiar"
                    onAction="#ClearClicked"
                    style="-fx-background-color: #6b7280;
                           -fx-text-fill: white; -fx-cursor: hand;" />
            <Button text="Registrar"
                    onAction="#RegisterClicked"
                    style="-fx-background-color: #2563eb;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;
                           -fx-cursor: hand;" />
        </HBox>
    </bottom>

</BorderPane>