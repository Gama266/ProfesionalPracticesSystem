<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="450.0" prefWidth="700.0" styleClass="mainFxmlClass"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="gui.controller.DeactivateTeacherController">
    <stylesheets>
        <URL value="@teachergui.css" />
    </stylesheets>
    <children>

        <Label layoutX="30.0" layoutY="25.0" text="Inactivar Profesores">
            <font>
                <Font name="System Bold" size="20.0" />
            </font>
        </Label>
        
        <Label layoutX="30.0" layoutY="55.0"
               text="Selecciona un profesor activo para inactivarlo."
               textFill="#5e5e5e" />

        <HBox layoutX="30.0" layoutY="80.0" alignment="CENTER_RIGHT" prefWidth="640.0">
            <children>
                <TextField fx:id="searchField"
                           prefHeight="28.0" prefWidth="220.0"
                           promptText="Buscar por nombre o número personal..." />
            </children>
        </HBox>

        <TableView fx:id="teacherTable"
                   layoutX="30.0" layoutY="118.0"
                   prefHeight="310.0" prefWidth="640.0">
            <columns>
                <TableColumn fx:id="personalNumberColumn" prefWidth="110.0" text="N° Personal" />
                <TableColumn fx:id="fullNameColumn" prefWidth="290.0" text="Nombre Completo" />
                <TableColumn fx:id="roleColumn" prefWidth="120.0" text="Rol" />
                <TableColumn fx:id="statusColumn" prefWidth="80.0" text="Estado" />
                <TableColumn fx:id="actionsColumn" prefWidth="80.0" text="Acciones" />
            </columns>
            <placeholder>
                <Label text="No hay profesores registrados." />
            </placeholder>
        </TableView>

    </children>
</AnchorPane>