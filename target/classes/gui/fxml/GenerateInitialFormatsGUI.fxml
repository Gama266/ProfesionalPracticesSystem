<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="600.0" prefWidth="800.0" style="-fx-background-color: #f1f5f9; -fx-padding: 30;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.controller.GenerateInitialFormatsGUIController">
    <VBox maxWidth="700.0" spacing="20.0" style="-fx-background-color: white; -fx-padding: 30; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">
        <HBox alignment="CENTER_LEFT">
            <Label text="Generar Formatos Iniciales" textFill="#1e293b"><font><Font name="System Bold" size="20.0" /></font></Label>
            <Region HBox.hgrow="ALWAYS" />
            <Button text="Simular Datos Incompletos (FA02)" style="-fx-border-color: #eab308; -fx-text-fill: #ca8a04;" />
        </HBox>
        <Label text="Verifique su información antes de generar el documento PDF." textFill="#64748b" />
        <HBox spacing="20.0">
            <VBox spacing="10.0" style="-fx-border-color: #e2e8f0; -fx-padding: 15; -fx-border-radius: 8;" HBox.hgrow="ALWAYS">
                <Label text="DATOS DEL PRACTICANTE" textFill="#64748b"><font><Font name="System Bold" size="12.0" /></font></Label>
                <Label fx:id="lblStudentName" text="Nombre: " />
                <Label fx:id="lblStudentId" text="Matrícula: " />
                <Label fx:id="lblProgram" text="Programa Educativo: Ingeniería de Software" />
                <Label fx:id="lblPeriod" text="Periodo: " />
            </VBox>
            <VBox spacing="10.0" style="-fx-background-color: #f0fdf4; -fx-padding: 15; -fx-background-radius: 8;" HBox.hgrow="ALWAYS">
                <Label text="PROYECTO ASIGNADO" textFill="#15803d"><font><Font name="System Bold" size="12.0" /></font></Label>
                <Label fx:id="lblProjectId" text="ID Proyecto: " />
                <Label fx:id="lblProjectName" text="Nombre: " wrapText="true" />
                <Label fx:id="lblOrg" text="Organización: " wrapText="true" />
                <Label fx:id="lblResponsible" text="Responsable Técnico: " wrapText="true" />
            </VBox>
        </HBox>
        <Label style="-fx-background-color: #fef9c3; -fx-padding: 15; -fx-border-color: #fde047; -fx-border-radius: 5; -fx-background-radius: 5;" text="Al hacer clic en 'Generar documento', el sistema creará un archivo PDF prellenado. Recuerde imprimirlo, firmarlo, recabar la firma y sello de su organización vinculada, y posteriormente subirlo al sistema." textFill="#854d0e" wrapText="true" />
        <HBox alignment="CENTER_RIGHT" spacing="15.0">
            <Button text="Cancelar" prefHeight="35.0" prefWidth="100.0" />
            <Button text="Generar documento" prefHeight="35.0" style="-fx-background-color: #2563eb; -fx-text-fill: white;" />
        </HBox>
    </VBox>
</VBox>