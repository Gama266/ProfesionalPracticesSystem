<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="700.0" prefWidth="1100.0"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="gui.controller.ReportDashboardController">

    <left>
        <VBox spacing="15.0"
              style="-fx-background-color: #1e293b;"
              prefWidth="240.0"
              BorderPane.alignment="CENTER">

            <padding>
                <Insets top="30" right="15" bottom="30" left="15"/>
            </padding>

            <children>

                <Label text="Reports Module"
                       textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="22"/>
                    </font>
                </Label>

                <Label text="Professional Practices"
                       textFill="#94a3b8">
                    <font>
                        <Font size="13"/>
                    </font>
                </Label>

                <Button fx:id="btnMonthlyReport"
                        mnemonicParsing="false"
                        onAction="#openMonthlyReport"
                        prefHeight="40.0"
                        prefWidth="200.0"
                        style="-fx-background-color: #334155;
                               -fx-text-fill: white;
                               -fx-font-size: 14;
                               -fx-background-radius: 8;
                               -fx-cursor: hand;"
                        text="Monthly Report"/>

                <Button fx:id="btnPartialReport"
                        mnemonicParsing="false"
                        onAction="#openPartialReport"
                        prefHeight="40.0"
                        prefWidth="200.0"
                        style="-fx-background-color: #334155;
                               -fx-text-fill: white;
                               -fx-font-size: 14;
                               -fx-background-radius: 8;
                               -fx-cursor: hand;"
                        text="Partial Report"/>

                <Button fx:id="btnFinalReport"
                        mnemonicParsing="false"
                        onAction="#openFinalReport"
                        prefHeight="40.0"
                        prefWidth="200.0"
                        style="-fx-background-color: #334155;
                               -fx-text-fill: white;
                               -fx-font-size: 14;
                               -fx-background-radius: 8;
                               -fx-cursor: hand;"
                        text="Final Report"/>

            </children>
        </VBox>
    </left>

    <center>

        <StackPane fx:id="contentStackPane"
                   style="-fx-background-color: #f1f5f9;"
                   BorderPane.alignment="CENTER"/>

    </center>

</BorderPane>