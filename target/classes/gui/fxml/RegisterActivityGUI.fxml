<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-border-color: transparent;"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="gui.controller.RegisterActivityGUIController">
   <content>
      <VBox>
         <padding>
            <Insets bottom="20.0" left="24.0" right="24.0" top="20.0" />
         </padding>
         <children>
            <VBox spacing="16.0">
               <padding>
                  <Insets bottom="26.0" left="28.0" right="28.0" top="26.0" />
               </padding>
               <children>

                  <VBox spacing="3.0">
                     <children>
                        <Label text="NUEVA ACTIVIDAD" textFill="#2bbfaa">
                           <font><Font name="System Bold" size="11.0" /></font>
                        </Label>
                        <Label text="Selecciona un proyecto de la lista y define su nueva actividad. Puedes agregar un máximo de 10 actividades." textFill="#7a8fa6" wrapText="true">
                           <font><Font size="12.0" /></font>
                        </Label>
                     </children>
                  </VBox>
                  <Separator prefWidth="200.0" />

                  <VBox spacing="5.0">
                     <children>
                        <Label text="Selecciona el Proyecto Destino *" textFill="#2c4a66">
                           <font><Font name="System Bold" size="12.0" /></font>
                        </Label>
                        <ComboBox fx:id="projectComboBox" maxWidth="1.7976931348623157E308" prefHeight="36.0" promptText="Seleccione un Proyecto *" style="-fx-background-color: white; -fx-border-color: #cdd4dc; -fx-border-radius: 3px; -fx-background-radius: 3px;" />
                        <Label fx:id="projectError" managed="false" text="Debes seleccionar un proyecto de la lista." textFill="#d32f2f" visible="false">
                           <font><Font size="11.0" /></font>
                        </Label>
                     </children>
                  </VBox>
                  
                  <Separator prefWidth="200.0" />

                  <VBox spacing="5.0">
                     <children>
                        <Label text="Nombre de la actividad *" textFill="#2c4a66">
                           <font><Font name="System Bold" size="12.0" /></font>
                        </Label>
                        <TextField fx:id="nameField" prefHeight="36.0" promptText="Ej. Análisis de requerimientos" />
                        <Label fx:id="nameError" managed="false" text="Error" textFill="#d32f2f" visible="false">
                           <font><Font size="11.0" /></font>
                        </Label>
                     </children>
                  </VBox>

                  <VBox spacing="5.0">
                     <children>
                        <Label text="Descripción *" textFill="#2c4a66">
                           <font><Font name="System Bold" size="12.0" /></font>
                        </Label>
                        <TextArea fx:id="descriptionArea" prefRowCount="4"
                                  promptText="Describe brevemente la actividad..."
                                  wrapText="true" />
                        <Label fx:id="descriptionError" managed="false" text="Error" textFill="#d32f2f" visible="false">
                           <font><Font size="11.0" /></font>
                        </Label>
                     </children>
                  </VBox>

                  <HBox spacing="20.0">
                     <children>

                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                           <children>
                              <Label text="Fecha de inicio *" textFill="#2c4a66">
                                 <font><Font name="System Bold" size="12.0" /></font>
                              </Label>
                              <DatePicker fx:id="startDatePicker" maxWidth="1.7976931348623157E308"
                                          prefHeight="36.0" promptText="dd/mm/aaaa" />
                              <Label fx:id="startDateError" managed="false" text="Error" textFill="#d32f2f" visible="false">
                                 <font><Font size="11.0" /></font>
                              </Label>
                           </children>
                        </VBox>

                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                           <children>
                              <Label text="Fecha de fin *" textFill="#2c4a66">
                                 <font><Font name="System Bold" size="12.0" /></font>
                              </Label>
                              <DatePicker fx:id="endDatePicker" maxWidth="1.7976931348623157E308"
                                          prefHeight="36.0" promptText="dd/mm/aaaa" />
                              <Label fx:id="endDateError" managed="false" text="Error" textFill="#d32f2f" visible="false">
                                 <font><Font size="11.0" /></font>
                              </Label>
                           </children>
                        </VBox>

                     </children>
                  </HBox>

                  <VBox spacing="5.0">
                     <children>
                        <Label text="Horas planeadas *" textFill="#2c4a66">
                           <font><Font name="System Bold" size="12.0" /></font>
                        </Label>
                        <TextField fx:id="plannedHoursField" prefHeight="36.0" promptText="Ej. 48.0" />
                        <Label fx:id="plannedHoursError" managed="false" text="Error" textFill="#d32f2f" visible="false">
                           <font><Font size="11.0" /></font>
                        </Label>
                     </children>
                  </VBox>

                  <Separator prefWidth="200.0" />

                  <HBox alignment="CENTER_RIGHT" spacing="10.0">
                     <children>
                        <Button mnemonicParsing="false" onAction="#handleClear"
                                prefHeight="36.0" text="Limpiar campos" />
                        <Button mnemonicParsing="false" onAction="#handleRegister"
                                prefHeight="36.0" text="Registrar Actividad"
                                style="-fx-background-color: #2bbfaa; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" />
                     </children>
                  </HBox>

                  <Label fx:id="resultLabel" managed="false" maxWidth="1.7976931348623157E308"
                         text="Resultado" visible="false" wrapText="true">
                     <font><Font name="System Bold" size="12.0" /></font>
                  </Label>

               </children>
            </VBox>
         </children>
      </VBox>
   </content>
</ScrollPane>